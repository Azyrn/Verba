<?xml version="1.0" encoding="utf-8"?><!--
   verba_settings holds preferences and saved translations, which stay on this
   device: kept out of cloud backup and device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/verba_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/verba_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
